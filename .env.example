# Copie para .env.local (desenvolvimento) ou cadastre como "Variables" no GitHub
# (Settings → Secrets and variables → Actions → Variables) para o build publicado.
# Todos são PÚBLICOS por natureza. Sem eles o app funciona só no aparelho, como antes.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-publica

# Chave pública VAPID (a privada fica SÓ nos secrets das Edge Functions)
VITE_VAPID_PUBLIC_KEY=

# NUNCA coloque aqui: service_role, ANTHROPIC_API_KEY, VAPID_PRIVATE_KEY, DISPATCH_SECRET.
