# Build de teste com conta, contra o servidor falso tests/e2e/mock-supabase.mjs (npm run build:e2e-cloud).
VITE_SUPABASE_URL=http://localhost:54399
VITE_SUPABASE_ANON_KEY=sb_publishable_mock
VITE_VAPID_PUBLIC_KEY=
VITE_TURNSTILE_SITE_KEY=
# The cloud test build exercises the AI planner against the mock server.
VITE_PLANNER_AI=on
